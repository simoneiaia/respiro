{
  "name": "respiro-benessere",
  "version": "0.2.0",
  "private": true,
  "description": "respiro.web.app: self-check orientativo del benessere psicologico. Strumento non diagnostico.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && npx firebase-tools deploy --only firestore,hosting --project respiro-benessere",
    "retention:audit": "node scripts/retention-audit.mjs",
    "retention:apply": "node scripts/retention-audit.mjs --apply"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "firebase": "^13.4.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
